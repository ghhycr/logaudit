# LogAudit API 环境变量示例（复制为 .env 或用于 docker compose）
# 生产环境必须修改以下默认值！

# API 监听端口
PORT=8080

# MySQL 连接串（audit 用户 / audit_meta 库；multiStatements 用于建表）
MYSQL_DSN=audit:audit2026@tcp(mysql:3306)/audit_meta?parseTime=true&charset=utf8mb4&loc=Local&multiStatements=true

# JWT 签名密钥（务必替换为随机长字符串：openssl rand -hex 32）
JWT_SECRET=change-me-please-9f2c4e1a

# 初始 admin 密码（留空则随机生成并打印到容器日志；生产建议显式设置）
ADMIN_INIT_PASSWORD=

# 访问令牌有效期（秒，默认 15 分钟）
ACCESS_TTL_SECONDS=900

# 刷新令牌有效期（小时，默认 7 天）
REFRESH_TTL_HOURS=168

# 等保三级：连续登录失败锁定阈值与分钟数
LOCK_THRESHOLD=5
LOCK_MINUTES=10
